# ============================================
# VaultGuard — Environment Configuration
# ============================================
# Copy this file to .env.local and fill in values.

# Database (PostgreSQL — Cloud SQL analogue)
DATABASE_URL="postgresql://vaultguard:vaultguard@localhost:5432/vaultguard?schema=public"

# Redis (Memorystore analogue — cache & rate-limits ONLY, not session SoT)
REDIS_URL="redis://localhost:6379"

# JWT (Identity Platform analogue — session source of truth per §3.2)
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Step-up MFA threshold (FR-11)
STEP_UP_MFA_THRESHOLD=5000

# Outbox worker
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_MAX_RETRIES=3
OUTBOX_BATCH_SIZE=10
