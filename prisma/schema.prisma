// ============================================================
// VaultGuard — Prisma Schema
// ============================================================
// Domain-isolated models matching Phase 1 §3.2 architecture:
//   Auth Domain    → User, MfaFactor, TrustedDevice, RefreshToken
//   Accounts Domain → Account
//   Payments Domain → Transaction, Payee, OutboxEvent
//   Loans Domain   → Loan, RepaymentSchedule
//   Audit Domain   → AuditEvent, DeadLetterEntry
//
// Single PostgreSQL instance with logical isolation.
// Phase 3 (Fortify) separates into per-domain Cloud SQL instances.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// AUTH DOMAIN (Member 2 — Kaushalya)
// ==========================================

enum UserRole {
  CUSTOMER
  SUPPORT_OPERATOR
}

model BackupIdentity {
  id         String   @id @default(uuid())
  nationalId String   @unique @map("national_id")
  fullName   String   @map("full_name")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("backup_identities")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  nationalId   String?  @unique @map("national_id")
  fullName     String   @map("full_name")
  phoneNumber  String?  @map("phone_number")
  role         UserRole @default(CUSTOMER)
  mfaEnabled   Boolean  @default(false) @map("mfa_enabled")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  accounts            Account[]
  payees              Payee[]
  loans               Loan[]
  mfaFactors          MfaFactor[]
  trustedDevices      TrustedDevice[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model MfaFactor {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  secret      String
  backupCodes String[]  @map("backup_codes")
  verifiedAt  DateTime? @map("verified_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_factors")
}

model TrustedDevice {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  fingerprint String
  userAgent   String   @map("user_agent")
  ipHash      String   @map("ip_hash")
  label       String?
  trustedAt   DateTime @default(now()) @map("trusted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trusted_devices")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ==========================================
// ACCOUNTS DOMAIN (Member 2 — Kaushalya)
// ==========================================

enum AccountType {
  SAVINGS
  CHECKING
  FIXED_DEPOSIT
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

model Account {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  accountNumber String        @unique @map("account_number")
  type          AccountType   @default(SAVINGS)
  balance       Decimal       @default(0) @db.Decimal(15, 2)
  currency      String        @default("LKR")
  status        AccountStatus @default(ACTIVE)
  dailyLimit    Decimal       @default(10000) @db.Decimal(15, 2) @map("daily_limit")
  singleLimit   Decimal       @default(5000) @db.Decimal(15, 2) @map("single_limit")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoingTransactions Transaction[] @relation("FromAccount")
  incomingTransactions Transaction[] @relation("ToAccount")
  loans                Loan[]

  @@map("accounts")
}

// ==========================================
// PAYMENTS DOMAIN (Member 3 — Anushka)
// ==========================================

enum TransactionType {
  TRANSFER
  BILL_PAY
  LOAN_REPAYMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  COMPENSATED
}

enum SagaStatus {
  INITIATED
  DEBITED
  CREDITED
  COMPLETED
  COMPENSATED
}

model Transaction {
  id            String            @id @default(uuid())
  requestId     String            @unique @map("request_id") // FR-13: idempotency key
  fromAccountId String            @map("from_account_id")
  toAccountId   String?           @map("to_account_id")
  amount        Decimal           @db.Decimal(15, 2)
  currency      String            @default("LKR")
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  sagaStatus    SagaStatus        @default(INITIATED) @map("saga_status") // §3.3 Saga tracking
  description   String?
  fee           Decimal           @default(0) @db.Decimal(15, 2)
  metadata      Json?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  fromAccount Account  @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccount   Account? @relation("ToAccount", fields: [toAccountId], references: [id])

  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([createdAt])
  @@map("transactions")
}

enum PayeeType {
  PERSON
  BILLER
}

model Payee {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  name          String
  accountNumber String   @map("account_number")
  bankCode      String?  @map("bank_code")
  type          PayeeType @default(PERSON)
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payees")
}

/// Transactional Outbox table (FR-14a, §3.3).
/// Written atomically with ledger commits.
/// Background worker polls and publishes to EventBus (Pub/Sub analogue).
model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String    @map("event_type")
  payload     Json
  processed   Boolean   @default(false)
  retryCount  Int       @default(0) @map("retry_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@index([processed, createdAt])
  @@map("outbox_events")
}

// ==========================================
// LOANS DOMAIN (Member 3 — Anushka)
// ==========================================

enum LoanStatus {
  ACTIVE
  PAID_OFF
  DEFAULTED
}

model Loan {
  id                 String     @id @default(uuid())
  userId             String     @map("user_id")
  accountId          String     @map("account_id")
  principalAmount    Decimal    @db.Decimal(15, 2) @map("principal_amount")
  outstandingBalance Decimal    @db.Decimal(15, 2) @map("outstanding_balance")
  interestRate       Decimal    @db.Decimal(5, 2) @map("interest_rate")
  termMonths         Int        @map("term_months")
  nextDueDate        DateTime   @map("next_due_date")
  status             LoanStatus @default(ACTIVE)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account             @relation(fields: [accountId], references: [id])
  repaymentSchedule RepaymentSchedule[]

  @@map("loans")
}

enum ScheduleStatus {
  UPCOMING
  PAID
  OVERDUE
}

model RepaymentSchedule {
  id      String         @id @default(uuid())
  loanId  String         @map("loan_id")
  dueDate DateTime       @map("due_date")
  amount  Decimal        @db.Decimal(15, 2)
  status  ScheduleStatus @default(UPCOMING)
  paidAt  DateTime?      @map("paid_at")

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@map("repayment_schedules")
}

// ==========================================
// AUDIT DOMAIN (Member 4 — Pushpika)
// ==========================================

/// Immutable audit event log (FR-19, NFR-O2).
/// Append-only — no UPDATE or DELETE operations allowed by service code.
model AuditEvent {
  id            String   @id @default(uuid())
  eventId       String   @unique @map("event_id") // FR-14b: dedup key
  actor         String                              // userId who performed action
  actorRole     String   @map("actor_role")
  action        String                              // e.g. "payment.completed", "auth.login"
  resource      String                              // e.g. "transaction", "user"
  resourceId    String?  @map("resource_id")
  metadata      Json?
  correlationId String?  @map("correlation_id")
  ipAddress     String?  @map("ip_address")
  timestamp     DateTime @default(now())

  @@index([actor])
  @@index([action])
  @@index([timestamp])
  @@map("audit_events")
}

/// Dead Letter Queue entries (FR-14b).
/// Events that failed processing after MAX_RETRIES.
model DeadLetterEntry {
  id              String    @id @default(uuid())
  originalEventId String    @map("original_event_id")
  eventType       String    @map("event_type")
  payload         Json
  failureReason   String    @map("failure_reason")
  retryCount      Int       @default(0) @map("retry_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  replayedAt      DateTime? @map("replayed_at")

  @@map("dead_letter_entries")
}
